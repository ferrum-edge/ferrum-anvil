        "trust_domain": "cluster.local",
        "service_account": "anvil-lab-svc",
        "addresses": [
          "127.0.0.1"
        ],
        "ports": [
          {
            "port": 17801,
            "protocol": "http",
            "name": "http"
          },
          {
            "port": 17802,
            "protocol": "udp",
            "name": "udp-echo"
          },
          {
            "port": 17803,
            "protocol": "udp",
            "name": "udp-silent"
          },
          {
            "port": 17804,
            "protocol": "udp",
            "name": "udp-closing"
          },
          {
            "port": 17805,
            "protocol": "udp",
            "name": "udp-unbound"
          },
          {
            "port": 17806,
            "protocol": "udp",
            "name": "dtls-echo"
          },
          {
            "port": 17807,
            "protocol": "udp",
            "name": "dtls-untrusted"
          }
        ],
        "selector": {
          "labels": {
            "app": "svc"
          },
          "namespace": "ferrum"
        }
      }
    ],
    "services": [
      {
        "name": "svc",
        "namespace": "ferrum",
        "ports": [
          {
            "port": 17801,
            "protocol": "http",
            "name": "http"
          }
        ],
        "workloads": [
          {
            "spiffe_id": "spiffe://cluster.local/ns/ferrum/sa/anvil-lab-svc"
          }
        ]
      }
    ],
    "peer_authentications": [
      {
        "name": "anvil-lab-{{MTLS_MODE}}",
        "namespace": "ferrum",
        "mtls_mode": "{{MTLS_MODE}}"
      }
    ],
    "mesh_policies": [
      {
        "name": "anvil-lab-deny-client-denied-path",
        "namespace": "ferrum",
        "scope": {
          "kind": "namespace",
          "namespace": "ferrum"
        },
        "rules": [
          {
            "from": [
              {
                "spiffe_id_pattern": "spiffe://cluster.local/ns/ferrum/sa/anvil-lab-client"
              }
            ],
            "to": [
              {
                "paths": [
                  "/denied/*"
                ]
              }
            ],
            "action": "deny"
          }
        ]
      }
    ]
  }
