{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferrum-edge/ferrum-contracts/schemas/diagnostic-report/v1.schema.json",
  "title": "ferrum.diagnostic_report v1",
  "description": "Diagnostic evidence exchanged between Ferrum Alloy tooling and other Ferrum products. Status: implemented by ferrum-alloy-diagnostics; PROPOSED as a shared contract. Readers reject other major versions and preserve unknown members of newer minor versions without interpreting them.",
  "x-contract": {
    "name": "diagnostic-report",
    "version": 1,
    "status": "implemented",
    "owner": "ferrum-edge/ferrum-alloy",
    "shared_status": "PROPOSED as a shared Ferrum contract; Anvil import is not tested (ferrum-alloy#27).",
    "wire_version": "ferrum.diagnostic_report 1.x",
    "upstream_id": "tag:ferrumedge.com,2026:alloy/schema/diagnostic-report/1",
    "provenance": [
      {
        "repo": "ferrum-edge/ferrum-alloy",
        "ref": "main",
        "commit": "fa471ccb79a444aee04661880af2385596d9da45",
        "path": "contracts/diagnostics/diagnostic-report.v1.schema.json",
        "note": "Copied verbatim; $id was replaced (the original is kept in x-contract.upstream_id) and x-contract was added. Alloy keeps it in sync with its Rust enums through crates/ferrum-alloy-diagnostics/tests/schema_parity.rs."
      }
    ]
  },
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "collection"
  ],
  "properties": {
    "schema": {
      "const": "ferrum.diagnostic_report"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]{1,4}$"
    },
    "report_id": {
      "type": "string",
      "maxLength": 2048
    },
    "generated_at": {
      "type": "string",
      "description": "RFC 3339. Informational only."
    },
    "collection": {
      "$ref": "#/$defs/Collection"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "observations": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/Observation"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced producer extensions (keys should start with `x-`)."
    }
  },
  "$defs": {
    "CollectionMethod": {
      "description": "How observations were gathered.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "live_export",
            "otlp_file_import",
            "offline_import",
            "fixture"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Verification": {
      "description": "Whether the collector authenticated each producer. A value read from a file is a claim; offline readers treat it as unverified.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "ProducerKind": {
      "description": "Producer family.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "edge",
            "alloy",
            "client",
            "collector",
            "user"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "ObservationKind": {
      "description": "Measurement or event.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "measurement",
            "event"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Availability": {
      "description": "Whether a value exists and why not. Unknown is not zero.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "measured",
            "unavailable",
            "unsupported",
            "not_applicable",
            "not_sampled",
            "export_pending",
            "dropped",
            "unknown"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Unit": {
      "description": "Unit of `value`.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "us",
            "ms",
            "s",
            "bytes",
            "count"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "ClockDomain": {
      "description": "Clock used to measure a value. Never subtract wall-clock values from different hosts.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "monotonic_local",
            "wall_clock"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Leg": {
      "description": "Connection leg.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "client_to_gateway",
            "gateway",
            "gateway_to_service",
            "service",
            "service_to_dependency",
            "unknown"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Trust": {
      "description": "Observation provenance.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "verified",
            "unverified",
            "user_asserted"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "SourceScope": {
      "description": "Finding scope (Ferrum Anvil `SourceScope`).",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "local_client",
            "client_to_peer",
            "gateway_admission",
            "gateway_to_upstream",
            "response_delivery",
            "forward_proxy",
            "upstream_application",
            "unknown"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Confidence": {
      "description": "Evidence strength (Ferrum Anvil `Confidence`); never a probability.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "confirmed",
            "likely",
            "unknown",
            "conflicting_evidence"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Severity": {
      "description": "Finding severity.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Owner": {
      "description": "Who can act (Ferrum Anvil `Owner`).",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "caller",
            "gateway_operator",
            "api_owner",
            "network_administrator",
            "identity_provider",
            "unknown"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "EvidenceSource": {
      "description": "Evidence source (Ferrum Anvil `EvidenceSource`; `gateway_telemetry` and `service_telemetry` are PROPOSED additions).",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "local_validation",
            "native_transport",
            "tls_verifier",
            "http_status",
            "http_header",
            "http_trailer",
            "grpc_status",
            "web_socket_close",
            "body_completion",
            "body_content",
            "configuration",
            "assertion",
            "ferrum_marker_trusted",
            "ferrum_marker_unverified",
            "gateway_detail",
            "gateway_telemetry",
            "service_telemetry"
          ]
        },
        {
          "description": "Readers must preserve unrecognized values and must not treat them as any known value.",
          "type": "string"
        }
      ]
    },
    "Producer": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProducerKind"
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "maxLength": 2048
        },
        "instance": {
          "type": "string",
          "maxLength": 2048,
          "description": "Process/host instance; wall-clock intervals are comparable only within one instance."
        }
      }
    },
    "Collection": {
      "type": "object",
      "required": [
        "collector",
        "method",
        "verification"
      ],
      "properties": {
        "collector": {
          "$ref": "#/$defs/Producer"
        },
        "method": {
          "$ref": "#/$defs/CollectionMethod"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "Subject": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "maxLength": 2048
        },
        "service": {
          "type": "string",
          "maxLength": 2048
        },
        "route": {
          "type": "string",
          "maxLength": 2048,
          "description": "Route template, never a raw path."
        }
      }
    },
    "Boundaries": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "Interval": {
      "type": "object",
      "required": [
        "start_unix_nano",
        "end_unix_nano"
      ],
      "properties": {
        "start_unix_nano": {
          "type": "integer",
          "minimum": 0
        },
        "end_unix_nano": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Scope": {
      "type": "object",
      "required": [
        "leg"
      ],
      "properties": {
        "leg": {
          "$ref": "#/$defs/Leg"
        },
        "service": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "description": "Absent means the attempt is unknown, not the first attempt."
        }
      }
    },
    "SpanRef": {
      "type": "object",
      "required": [
        "trace_id",
        "span_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "parent_span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      }
    },
    "Observation": {
      "type": "object",
      "description": "A collected fact. Unknown members are preserved and reported, never interpreted.",
      "required": [
        "id",
        "producer",
        "kind",
        "name",
        "availability",
        "scope",
        "trust"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "kind": {
          "$ref": "#/$defs/ObservationKind"
        },
        "name": {
          "type": "string",
          "description": "Catalog name, e.g. `alloy.server.time_to_headers` (docs/measurement-semantics.md)."
        },
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "value": {
          "type": "number",
          "description": "Present only when availability is `measured`."
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "boundaries": {
          "$ref": "#/$defs/Boundaries"
        },
        "clock": {
          "$ref": "#/$defs/ClockDomain"
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "span": {
          "$ref": "#/$defs/SpanRef"
        },
        "attributes": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "trust": {
          "$ref": "#/$defs/Trust"
        },
        "evidence_ref": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "Evidence": {
      "type": "object",
      "required": [
        "source",
        "key",
        "value"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "Remediation": {
      "type": "object",
      "required": [
        "text",
        "owner"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Plain text; never an executable command."
        },
        "owner": {
          "$ref": "#/$defs/Owner"
        }
      }
    },
    "Finding": {
      "type": "object",
      "description": "A derived conclusion: a superset of Ferrum Anvil's DiagnosticFinding. Readers recompute findings; supplied findings are never evidence.",
      "required": [
        "code",
        "rule_id",
        "rule_version",
        "title",
        "explanation",
        "scope",
        "confidence",
        "severity",
        "evidence",
        "alternatives",
        "does_not_prove",
        "remediation",
        "owner",
        "confirm_with"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "rule_version": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SourceScope"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "does_not_prove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remediation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Remediation"
          }
        },
        "owner": {
          "$ref": "#/$defs/Owner"
        },
        "confirm_with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_observations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
