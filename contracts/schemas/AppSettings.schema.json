{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppSettings",
  "description": "Portable application settings (included in whole-app backups).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "defaults": {
      "$ref": "#/$defs/SettingsOverrides"
    },
    "theme": {
      "$ref": "#/$defs/Theme"
    },
    "history": {
      "$ref": "#/$defs/HistoryPolicy"
    },
    "lock": {
      "$ref": "#/$defs/LockPolicy"
    },
    "autosave": {
      "type": "boolean"
    },
    "redaction_names": {
      "description": "Extra header/query/cookie/body-field names always treated as secrets\nby the redactor (in addition to built-in patterns).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "check_for_updates": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "defaults",
    "theme",
    "history",
    "lock",
    "autosave",
    "redaction_names",
    "check_for_updates"
  ],
  "$defs": {
    "SettingsOverrides": {
      "description": "Non-secret request settings resolved deterministically:\napp defaults → workspace → ancestor folders → request → run override.\nEvery field is optional at each layer; `None` inherits.",
      "type": "object",
      "properties": {
        "http_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpVersionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeouts": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeoutOverrides"
            },
            {
              "type": "null"
            }
          ]
        },
        "redirects": {
          "anyOf": [
            {
              "$ref": "#/$defs/RedirectPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "retries": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "ip_preference": {
          "anyOf": [
            {
              "$ref": "#/$defs/IpPreference"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolver": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolverMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "dns_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DnsOverride"
          }
        },
        "proxy_profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProxySelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "tls_profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Limits"
            },
            {
              "type": "null"
            }
          ]
        },
        "decompress": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cookies": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "keepalive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "infer_content_type": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "integration_profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HttpVersionPolicy": {
      "description": "Protocol negotiation policy for HTTP-family requests.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "http1_only"
          ]
        },
        {
          "description": "ALPN negotiation over TLS (h2, then http/1.1); HTTP/1.1 for cleartext.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "HTTP/2 over TLS (ALPN `h2` only — fails rather than silently using HTTP/1.1).",
          "type": "string",
          "const": "http2_only"
        },
        {
          "description": "Cleartext HTTP/2 with prior knowledge.",
          "type": "string",
          "const": "h2c"
        },
        {
          "description": "Forced HTTP/3 over QUIC. Never silently sends over TCP.",
          "type": "string",
          "const": "http3_only"
        },
        {
          "description": "Try HTTP/3 first, then fall back to TCP; every attempt is recorded.",
          "type": "string",
          "const": "http3_with_fallback"
        }
      ]
    },
    "TimeoutOverrides": {
      "description": "Partial timeout overrides (each class independently inheritable).",
      "type": "object",
      "properties": {
        "dns_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "connect_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tls_handshake_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "request_write_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "response_headers_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "body_idle_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "total_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "RedirectPolicy": {
      "type": "object",
      "properties": {
        "follow": {
          "type": "boolean"
        },
        "max": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "forward_credentials_cross_origin": {
          "description": "Forward `Authorization`/cookies/client identity to a different origin.\nOff by default; the target's own configuration applies otherwise.",
          "type": "boolean"
        }
      },
      "required": [
        "follow",
        "max",
        "forward_credentials_cross_origin"
      ]
    },
    "RetryPolicy": {
      "description": "Automatic retry policy. Off by default. Possibly-processed non-idempotent\noperations are never retried automatically regardless of this setting.",
      "type": "object",
      "properties": {
        "max_retries": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "backoff_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "only_safe": {
          "description": "Retained for compatibility. Retries are always limited to failures\nproven `not_dispatched` or idempotent methods; a possibly processed\nnon-idempotent request is never replayed, whatever this says.",
          "type": "boolean"
        }
      },
      "required": [
        "max_retries",
        "backoff_ms",
        "only_safe"
      ]
    },
    "IpPreference": {
      "type": "string",
      "enum": [
        "system",
        "prefer_ipv4",
        "prefer_ipv6",
        "ipv4_only",
        "ipv6_only"
      ]
    },
    "ResolverMode": {
      "oneOf": [
        {
          "description": "Operating-system resolver (getaddrinfo).",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "Query the given DNS servers directly (`ip:port`), bypassing the OS resolver.",
          "type": "object",
          "properties": {
            "nameservers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "type": "string",
              "const": "custom"
            }
          },
          "required": [
            "mode",
            "nameservers"
          ]
        }
      ]
    },
    "DnsOverride": {
      "type": "object",
      "properties": {
        "host": {
          "description": "Host name to override (exact, case-insensitive).",
          "type": "string"
        },
        "addresses": {
          "description": "Addresses to connect to instead of resolving.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "host",
        "addresses"
      ]
    },
    "ProxySelection": {
      "description": "Explicit proxy choice: a profile, or explicitly none (overrides inherited).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "type": "string",
              "const": "profile"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "Id": {
      "description": "Stable object identifier. UUIDv7 so ids sort roughly by creation time.",
      "type": "string",
      "format": "uuid"
    },
    "Limits": {
      "type": "object",
      "properties": {
        "max_response_bytes": {
          "description": "Hard ceiling on response body bytes read from the wire; exceeded bodies\nend with a local `response_too_large` outcome (never a peer fault).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "capture_bytes": {
          "description": "Bytes retained for display/history; beyond this the body is still read\nand counted but marked display-truncated.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_decoded_bytes": {
          "description": "Ceiling on decompressed size.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_response_header_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_request_body_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "max_response_bytes",
        "capture_bytes",
        "max_decoded_bytes",
        "max_response_header_bytes",
        "max_request_body_bytes"
      ]
    },
    "Theme": {
      "type": "string",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    },
    "HistoryPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "keep_response_bodies": {
          "type": "boolean"
        },
        "max_age_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "keep_response_bodies",
        "max_age_days",
        "max_total_bytes"
      ]
    },
    "LockPolicy": {
      "type": "object",
      "properties": {
        "idle_minutes": {
          "description": "Lock after this many minutes of inactivity (0 = never).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lock_on_os_lock": {
          "type": "boolean"
        },
        "run_policy": {
          "$ref": "#/$defs/LockRunPolicy"
        },
        "clear_clipboard_on_lock": {
          "type": "boolean"
        }
      },
      "required": [
        "idle_minutes",
        "lock_on_os_lock",
        "run_policy",
        "clear_clipboard_on_lock"
      ]
    },
    "LockRunPolicy": {
      "description": "What happens to active runs when the vault locks.",
      "oneOf": [
        {
          "description": "Cancel active sends/loads and finalize partial reports (default).",
          "type": "string",
          "const": "stop_runs"
        }
      ]
    }
  }
}
