{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionCommand",
  "description": "Commands for an interactive session (WebSocket / TCP / UDP / bidi gRPC).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "send_text"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "send_binary_hex"
        },
        "hex": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "hex"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "ping"
        }
      },
      "required": [
        "command"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "close"
        },
        "code": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "code",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "half_close"
        }
      },
      "required": [
        "command"
      ]
    }
  ]
}
