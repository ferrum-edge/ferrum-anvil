{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Folder",
  "description": "Common persistent metadata.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace_id": {
      "$ref": "#/$defs/Id"
    },
    "parent_id": {
      "description": "`None` = top level of the workspace.",
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "sort_key": {
      "description": "Fractional ordering key among siblings.",
      "type": "number",
      "format": "double"
    },
    "settings": {
      "$ref": "#/$defs/SettingsOverrides",
      "default": {}
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Variable"
      },
      "default": []
    },
    "auth": {
      "$ref": "#/$defs/AuthConfig",
      "default": {
        "type": "inherit"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "updated_at",
    "workspace_id",
    "name",
    "sort_key"
  ],
  "$defs": {
    "Id": {
      "description": "Stable object identifier. UUIDv7 so ids sort roughly by creation time.",
      "type": "string",
      "format": "uuid"
    },
    "SettingsOverrides": {
      "description": "Non-secret request settings resolved deterministically:\napp defaults → workspace → ancestor folders → request → run override.\nEvery field is optional at each layer; `None` inherits.",
      "type": "object",
      "properties": {
        "http_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpVersionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeouts": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeoutOverrides"
            },
            {
              "type": "null"
            }
          ]
        },
        "redirects": {
          "anyOf": [
            {
              "$ref": "#/$defs/RedirectPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "retries": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "ip_preference": {
          "anyOf": [
            {
              "$ref": "#/$defs/IpPreference"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolver": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolverMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "dns_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DnsOverride"
          }
        },
        "proxy_profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProxySelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "tls_profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Limits"
            },
            {
              "type": "null"
            }
          ]
        },
        "decompress": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cookies": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "keepalive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "infer_content_type": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "integration_profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HttpVersionPolicy": {
      "description": "Protocol negotiation policy for HTTP-family requests.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "http1_only"
          ]
        },
        {
          "description": "ALPN negotiation over TLS (h2, then http/1.1); HTTP/1.1 for cleartext.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "HTTP/2 over TLS (ALPN `h2` only — fails rather than silently using HTTP/1.1).",
          "type": "string",
          "const": "http2_only"
        },
        {
          "description": "Cleartext HTTP/2 with prior knowledge.",
          "type": "string",
          "const": "h2c"
        },
        {
          "description": "Forced HTTP/3 over QUIC. Never silently sends over TCP.",
          "type": "string",
          "const": "http3_only"
        },
        {
          "description": "Try HTTP/3 first, then fall back to TCP; every attempt is recorded.",
          "type": "string",
          "const": "http3_with_fallback"
        }
      ]
    },
    "TimeoutOverrides": {
      "description": "Partial timeout overrides (each class independently inheritable).",
      "type": "object",
      "properties": {
        "dns_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "connect_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tls_handshake_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "request_write_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "response_headers_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "body_idle_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "total_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "RedirectPolicy": {
      "type": "object",
      "properties": {
        "follow": {
          "type": "boolean"
        },
        "max": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "forward_credentials_cross_origin": {
          "description": "Forward `Authorization`/cookies/client identity to a different origin.\nOff by default; the target's own configuration applies otherwise.",
          "type": "boolean"
        }
      },
      "required": [
        "follow",
        "max",
        "forward_credentials_cross_origin"
      ]
    },
    "RetryPolicy": {
      "description": "Automatic retry policy. Off by default. Possibly-processed non-idempotent\noperations are never retried automatically regardless of this setting.",
      "type": "object",
      "properties": {
        "max_retries": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "backoff_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "only_safe": {
          "description": "Retry only failures proven `not_dispatched`, or idempotent methods.",
          "type": "boolean"
        }
      },
      "required": [
        "max_retries",
        "backoff_ms",
        "only_safe"
      ]
    },
    "IpPreference": {
      "type": "string",
      "enum": [
        "system",
        "prefer_ipv4",
        "prefer_ipv6",
        "ipv4_only",
        "ipv6_only"
      ]
    },
    "ResolverMode": {
      "oneOf": [
        {
          "description": "Operating-system resolver (getaddrinfo).",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "Query the given DNS servers directly (`ip:port`), bypassing the OS resolver.",
          "type": "object",
          "properties": {
            "nameservers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "type": "string",
              "const": "custom"
            }
          },
          "required": [
            "mode",
            "nameservers"
          ]
        }
      ]
    },
    "DnsOverride": {
      "type": "object",
      "properties": {
        "host": {
          "description": "Host name to override (exact, case-insensitive).",
          "type": "string"
        },
        "addresses": {
          "description": "Addresses to connect to instead of resolving.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "host",
        "addresses"
      ]
    },
    "ProxySelection": {
      "description": "Explicit proxy choice: a profile, or explicitly none (overrides inherited).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "type": "string",
              "const": "profile"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "max_response_bytes": {
          "description": "Hard ceiling on response body bytes read from the wire; exceeded bodies\nend with a local `response_too_large` outcome (never a peer fault).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "capture_bytes": {
          "description": "Bytes retained for display/history; beyond this the body is still read\nand counted but marked display-truncated.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_decoded_bytes": {
          "description": "Ceiling on decompressed size.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_response_header_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_request_body_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "max_response_bytes",
        "capture_bytes",
        "max_decoded_bytes",
        "max_response_header_bytes",
        "max_request_body_bytes"
      ]
    },
    "Variable": {
      "description": "Variable in a workspace base set, an environment, a folder or a request.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SensitiveValue"
        },
        "secret": {
          "description": "Secret variables are masked, redacted from history/reports and replaced\nby placeholders in safe-share exports.",
          "type": "boolean",
          "default": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "SensitiveValue": {
      "description": "A field that may carry sensitive material (password, token, key).\n\n* `Template` — text that may contain `{{variable}}` references. A literal\n  (non-variable) template in a sensitive field is itself treated as\n  sensitive: it is masked in the UI, redacted in history, and replaced by a\n  placeholder in safe-share exports.\n* `Secret` — a vault reference.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "template"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "secret": {
              "$ref": "#/$defs/SecretRef"
            },
            "kind": {
              "type": "string",
              "const": "secret"
            }
          },
          "required": [
            "kind",
            "secret"
          ]
        }
      ]
    },
    "SecretRef": {
      "description": "Reference to a value held in the encrypted vault. The value itself never\nappears in ordinary object graphs, logs or safe-share exports.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "description": "Human label shown in the UI and in export previews (\"prod API key\").",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "AuthConfig": {
      "description": "Auth configuration. Applied after interpolation, content-type inference\nand serialization so body-dependent signatures cover the final bytes.",
      "oneOf": [
        {
          "description": "Use the nearest ancestor folder/workspace auth.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "inherit"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Explicitly send no credentials (clears inherited auth).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/SensitiveValue"
            },
            "location": {
              "$ref": "#/$defs/KeyLocation",
              "default": "header"
            },
            "type": {
              "type": "string",
              "const": "api_key"
            }
          },
          "required": [
            "type",
            "name",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            },
            "password": {
              "$ref": "#/$defs/SensitiveValue"
            },
            "type": {
              "type": "string",
              "const": "basic"
            }
          },
          "required": [
            "type",
            "username",
            "password"
          ]
        },
        {
          "type": "object",
          "properties": {
            "token": {
              "$ref": "#/$defs/SensitiveValue"
            },
            "prefix": {
              "type": "string",
              "default": "Bearer"
            },
            "type": {
              "type": "string",
              "const": "bearer"
            }
          },
          "required": [
            "type",
            "token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "$ref": "#/$defs/JwtAlgorithm"
            },
            "signing_key": {
              "description": "HMAC secret, or PKCS#8 PEM private key for RS/ES algorithms.",
              "$ref": "#/$defs/SensitiveValue"
            },
            "claims": {
              "$ref": "#/$defs/JwtClaims"
            },
            "kid": {
              "type": [
                "string",
                "null"
              ]
            },
            "header_name": {
              "description": "Header carrying the token (default `Authorization: Bearer`).",
              "type": "string",
              "default": "Authorization"
            },
            "prefix": {
              "type": "string",
              "default": "Bearer"
            },
            "type": {
              "type": "string",
              "const": "jwt"
            }
          },
          "required": [
            "type",
            "algorithm",
            "signing_key",
            "claims"
          ]
        },
        {
          "type": "object",
          "properties": {
            "config": {
              "$ref": "#/$defs/OAuth2Config"
            },
            "type": {
              "type": "string",
              "const": "oauth2"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "config": {
              "$ref": "#/$defs/HmacConfig"
            },
            "type": {
              "type": "string",
              "const": "hmac"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "config": {
              "$ref": "#/$defs/DpopConfig"
            },
            "type": {
              "type": "string",
              "const": "dpop"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "description": "SOAP WS-Security header inserted into the SOAP envelope.",
          "type": "object",
          "properties": {
            "config": {
              "$ref": "#/$defs/WsseConfig"
            },
            "type": {
              "type": "string",
              "const": "wsse"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "description": "Several explicit presentations in one request (e.g. mTLS + API key).\nOrder is preserved; conflicting headers fail validation.",
          "type": "object",
          "properties": {
            "profiles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AuthConfig"
              }
            },
            "type": {
              "type": "string",
              "const": "multi"
            }
          },
          "required": [
            "type",
            "profiles"
          ]
        }
      ]
    },
    "KeyLocation": {
      "description": "Where an API key is presented.",
      "type": "string",
      "enum": [
        "header",
        "query",
        "cookie"
      ]
    },
    "JwtAlgorithm": {
      "type": "string",
      "enum": [
        "HS256",
        "HS384",
        "HS512",
        "RS256",
        "ES256"
      ]
    },
    "JwtClaims": {
      "description": "Claims editor for the JWT helper. Anvil signs only with key material the\nuser supplies; it never invents an issuer or a gateway token endpoint.",
      "type": "object",
      "properties": {
        "iss": {
          "type": [
            "string",
            "null"
          ]
        },
        "sub": {
          "type": [
            "string",
            "null"
          ]
        },
        "aud": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_in_secs": {
          "description": "Lifetime in seconds from signing time; `exp` is computed per send.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "not_before_offset_secs": {
          "description": "`nbf` offset (seconds, may be negative) relative to signing time.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "extra_json": {
          "description": "Additional claims as a JSON object text (may contain `{{vars}}`).",
          "type": "string"
        }
      }
    },
    "OAuth2Config": {
      "type": "object",
      "properties": {
        "grant": {
          "$ref": "#/$defs/OAuthGrant"
        },
        "token_url": {
          "type": "string"
        },
        "authorization_url": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "description": "Confidential-client secret (client credentials). Public PKCE clients\nleave this empty.",
          "$ref": "#/$defs/SensitiveValue",
          "default": {
            "kind": "template",
            "value": ""
          }
        },
        "scope": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "client_auth": {
          "description": "How client credentials are sent to the token endpoint.",
          "$ref": "#/$defs/OAuthClientAuth",
          "default": "basic_header"
        },
        "token_cache_id": {
          "description": "Where the acquired access token is cached (vault) — id of the token\ncache entry, managed by the engine.",
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh_skew_secs": {
          "description": "Refresh this many seconds before expiry.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 30
        }
      },
      "required": [
        "grant",
        "token_url",
        "client_id"
      ]
    },
    "OAuthGrant": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "client_credentials",
            "refresh_token"
          ]
        },
        {
          "description": "Authorization code with PKCE (S256) through the external system browser\nand a loopback redirect bound to one authorization attempt.",
          "type": "string",
          "const": "authorization_code_pkce"
        }
      ]
    },
    "OAuthClientAuth": {
      "type": "string",
      "enum": [
        "basic_header",
        "request_body"
      ]
    },
    "HmacConfig": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/HmacProfile",
          "default": "ferrum_v2"
        },
        "username": {
          "type": "string"
        },
        "secret": {
          "$ref": "#/$defs/SensitiveValue"
        },
        "algorithm": {
          "$ref": "#/$defs/HmacAlgorithm",
          "default": "hmac_sha256"
        },
        "digest_header": {
          "$ref": "#/$defs/BodyDigestHeader",
          "default": "content_digest"
        },
        "namespace": {
          "description": "Optional namespace bound into the signature when the gateway profile uses one.",
          "type": "string"
        },
        "allow_unsafe_legacy": {
          "description": "Explicit opt-in required to use the replayable legacy profile.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "username",
        "secret"
      ]
    },
    "HmacProfile": {
      "description": "HMAC request signing profile. `FerrumV2` is the gateway's current\nsingle-use profile; `FerrumV1Legacy` is disabled unless the user explicitly\nenables the unsafe compatibility option.",
      "type": "string",
      "enum": [
        "ferrum_v2",
        "ferrum_v1_legacy"
      ]
    },
    "HmacAlgorithm": {
      "type": "string",
      "enum": [
        "hmac_sha256",
        "hmac_sha384",
        "hmac_sha512"
      ]
    },
    "BodyDigestHeader": {
      "oneOf": [
        {
          "description": "RFC 9530 `Content-Digest: sha-256=:<b64>:`.",
          "type": "string",
          "const": "content_digest"
        },
        {
          "description": "Legacy RFC 3230 `Digest: SHA-256=<b64>`.",
          "type": "string",
          "const": "legacy_digest"
        }
      ]
    },
    "DpopConfig": {
      "type": "object",
      "properties": {
        "access_token": {
          "description": "The access token (bound to the proof key by the issuer).",
          "$ref": "#/$defs/SensitiveValue"
        },
        "private_key_pem": {
          "description": "PKCS#8 PEM of the ES256 proof key (vault reference recommended).",
          "$ref": "#/$defs/SensitiveValue"
        },
        "dpop_scheme": {
          "description": "Present the token as `DPoP <token>` (RFC 9449) or legacy `Bearer`.",
          "type": "boolean",
          "default": true
        },
        "handle_nonce_challenge": {
          "description": "Automatically answer a single `use_dpop_nonce` challenge with a fresh proof.",
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "access_token",
        "private_key_pem"
      ]
    },
    "WsseConfig": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "$ref": "#/$defs/SensitiveValue"
        },
        "password_type": {
          "$ref": "#/$defs/WssePasswordType",
          "default": "password_text"
        },
        "timestamp_ttl_secs": {
          "description": "Add a `wsu:Timestamp` with this lifetime.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "saml_assertion": {
          "description": "User-provided signed SAML assertion XML to embed verbatim (Anvil never\nmints assertions).",
          "anyOf": [
            {
              "$ref": "#/$defs/SensitiveValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "WssePasswordType": {
      "type": "string",
      "enum": [
        "password_text",
        "password_digest"
      ]
    }
  }
}
