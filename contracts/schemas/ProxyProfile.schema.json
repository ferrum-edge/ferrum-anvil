{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProxyProfile",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id"
    },
    "workspace_id": {
      "$ref": "#/$defs/Id"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ProxyKind"
    },
    "address": {
      "description": "`host:port` of the proxy.",
      "type": "string"
    },
    "username": {
      "type": [
        "string",
        "null"
      ]
    },
    "password": {
      "anyOf": [
        {
          "$ref": "#/$defs/SensitiveValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "no_proxy": {
      "description": "`NO_PROXY` semantics: comma-separated hosts/suffixes/CIDRs, `*` for all.",
      "type": "string",
      "default": ""
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "name",
    "kind",
    "address",
    "created_at",
    "updated_at"
  ],
  "$defs": {
    "Id": {
      "description": "Stable object identifier. UUIDv7 so ids sort roughly by creation time.",
      "type": "string",
      "format": "uuid"
    },
    "ProxyKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "socks5"
          ]
        },
        {
          "description": "HTTP forward proxy (absolute-form for http://, CONNECT for https://).",
          "type": "string",
          "const": "http"
        },
        {
          "description": "HTTPS connection to the proxy itself, then CONNECT.",
          "type": "string",
          "const": "https"
        }
      ]
    },
    "SensitiveValue": {
      "description": "A field that may carry sensitive material (password, token, key).\n\n* `Template` — text that may contain `{{variable}}` references. A literal\n  (non-variable) template in a sensitive field is itself treated as\n  sensitive: it is masked in the UI, redacted in history, and replaced by a\n  placeholder in safe-share exports.\n* `Secret` — a vault reference.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "template"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "secret": {
              "$ref": "#/$defs/SecretRef"
            },
            "kind": {
              "type": "string",
              "const": "secret"
            }
          },
          "required": [
            "kind",
            "secret"
          ]
        }
      ]
    },
    "SecretRef": {
      "description": "Reference to a value held in the encrypted vault. The value itself never\nappears in ordinary object graphs, logs or safe-share exports.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "description": "Human label shown in the UI and in export previews (\"prod API key\").",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ]
    }
  }
}
