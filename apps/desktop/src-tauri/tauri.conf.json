{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrum Anvil",
  "version": "0.1.0",
  "identifier": "com.ferrumedge.anvil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ferrum Anvil",
        "width": 1440,
        "height": 920,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Put your APIs to the test",
    "longDescription": "Ferrum Anvil is a local-first API and network testing client with evidence-based diagnostics for Ferrum Edge.",
    "copyright": "\u00a9 2026 Ferrum Edge. PolyForm Noncommercial 1.0.0 with commercial licensing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../LICENSE-COMMERCIAL.md": "licenses/LICENSE-COMMERCIAL.md",
      "../../../THIRD_PARTY_LICENSES.md": "licenses/THIRD_PARTY_LICENSES.md"
    }
  }
}
