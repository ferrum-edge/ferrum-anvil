{
  "swagger": "2.0",
  "info": {
    "title": "Orders",
    "version": "1.0.0",
    "description": "Orders of the shop.",
    "contact": { "name": "Orders team", "email": "orders@acme.example" },
    "license": { "name": "Apache-2.0", "url": "https://www.apache.org/licenses/LICENSE-2.0" }
  },
  "host": "orders.acme.example",
  "basePath": "/v1",
  "schemes": ["http"],
  "produces": ["application/json"],
  "tags": [{ "name": "orders", "description": "Orders" }],
  "security": [{ "oauth": ["orders"] }],
  "securityDefinitions": {
    "oauth": { "type": "oauth2", "flow": "application", "tokenUrl": "https://auth.acme.example/token", "scopes": { "orders": "Orders" } }
  },
  "paths": {
    "/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List orders",
        "description": "Lists orders, newest first.",
        "tags": ["orders"],
        "parameters": [{ "name": "page_size", "in": "query", "description": "Page size.", "type": "integer" }],
        "responses": {
          "200": {
            "description": "A page of orders",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Order" } },
            "examples": { "application/json": [{ "id": 1, "total_amount": 10 }] }
          },
          "400": { "description": "Bad request", "schema": { "$ref": "#/definitions/Problem" } }
        }
      }
    },
    "/v1/orders/{orderId}": {
      "get": {
        "operationId": "get_order",
        "description": "One order.",
        "tags": ["orders"],
        "responses": {
          "200": { "description": "The order", "schema": { "$ref": "#/definitions/Order" } }
        }
      }
    }
  },
  "definitions": {
    "Order": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "integer" }, "total_amount": { "type": "number", "minimum": 0 } }
    },
    "Problem": { "type": "object", "properties": { "title": { "type": "string" } } }
  }
}
